# GitHub Actions CI
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repo

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Target website (for browser inspection — M3)
TARGET_WEBSITE_URL=

# LLM (Ollama Cloud default — OpenAI-compatible)
OLLAMA_API_KEY=
LLM_API_URL=https://ollama.com/v1
LLM_MODEL=glm-5.1

# OpenAI fallback (optional — set LLM_API_URL and LLM_MODEL to switch)
# OPENAI_API_KEY=

# Cloudflare Browser Rendering (default browser backend for M3)
# Set these to use Cloudflare. Omit both to fall back to local Chromium.
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_BROWSER_ENDPOINT=wss://api.cloudflare.com/client/v4/accounts/${CF_ACCOUNT_ID}/browser-rendering/devtools/browser?keep_alive=600000